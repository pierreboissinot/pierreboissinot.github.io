---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../lib/blog';

interface Props {
  lang: Lang;
  translationUrl?: string | null;
}

const { lang, translationUrl = null } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'fr' ? '/fr/' : '/';
const postsUrl = lang === 'fr' ? '/fr/posts/' : '/posts/';
const seriesUrl = lang === 'fr' ? '/fr/series/openspec/' : '/series/openspec/';
---

<header class="site-header">
  <a href={home} class="wordmark">pierre boissinot.</a>
  <nav aria-label="Main">
    <a href={postsUrl}>{t('nav.posts')}</a>
    <a href={seriesUrl}>OpenSpec</a>
    <LanguageSwitcher {lang} {translationUrl} />
    <ThemeToggle />
  </nav>
</header>
