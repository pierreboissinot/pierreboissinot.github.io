---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const rssHref = lang === 'fr' ? '/fr/rss.xml' : '/rss.xml';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="wordmark-big">pierre boissinot.</p>
  <p>{t('footer.builtWith')}</p>
  <nav aria-label="Footer">
    <a href={rssHref}>{t('footer.rss')}</a>
    <a href="https://github.com/pierreboissinot" rel="me">GitHub</a>
    <a href="https://www.linkedin.com/in/pierreboissinot/" rel="me">LinkedIn</a>
  </nav>
  <p class="colophon">© {year} Pierre Boissinot</p>
</footer>
