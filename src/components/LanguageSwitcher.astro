---
import { otherLang, type Lang } from '../lib/blog';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  translationUrl?: string | null;
}

const { lang, translationUrl = null } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const target = translationUrl ?? (lang === 'en' ? '/fr/' : '/');
const isFallback = !translationUrl;
---

<a
  class="lang-switcher"
  href={target}
  hreflang={other}
  lang={other}
  title={isFallback ? t('switcher.fallbackTitle') : undefined}
>
  {isFallback && <span aria-hidden="true">~</span>}{other.toUpperCase()}
</a>
