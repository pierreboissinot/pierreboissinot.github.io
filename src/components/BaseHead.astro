---
import { Font } from 'astro:assets';
import { otherLang, type Lang } from '../lib/blog';
import { ogLocaleOf } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  translationUrl?: string | null;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const { lang, title, description, translationUrl = null, ogType = 'website', pubDate, updatedDate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = otherLang(lang);
const siteName = 'Pierre Boissinot';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title === siteName ? title : `${title} — ${siteName}`}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

{
  translationUrl && (
    <>
      <link rel="alternate" hreflang={other} href={new URL(translationUrl, Astro.site)} />
      <link rel="alternate" hreflang={lang} href={canonical} />
      <link
        rel="alternate"
        hreflang="x-default"
        href={lang === 'en' ? canonical : new URL(translationUrl, Astro.site)}
      />
    </>
  )
}

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocaleOf(lang)} />
{translationUrl && <meta property="og:locale:alternate" content={ogLocaleOf(other)} />}
{ogType === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{ogType === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
<meta name="twitter:card" content="summary" />

<link rel="alternate" type="application/rss+xml" title={`${siteName} (EN)`} href="/rss.xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteName} (FR)`} href="/fr/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F7F2" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0A0A" />

<Font cssVariable="--font-archivo" preload />
<Font cssVariable="--font-jetbrains-mono" />

<script is:inline>
  // Theme before first paint: stored choice, else system preference. No FOUC.
  (() => {
    const stored = localStorage.getItem('theme');
    const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', dark);
    // JS-managed theme-color (last one wins over the media-query pair above,
    // and follows the toggle instead of only the system preference).
    const meta = document.createElement('meta');
    meta.name = 'theme-color';
    meta.content = dark ? '#0A0A0A' : '#F7F7F2';
    document.head.appendChild(meta);
  })();
</script>
