---
import type { CollectionEntry } from 'astro:content';
import { postUrl, seriesUrl, type BlogPost, type Lang } from '../lib/blog';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  series: CollectionEntry<'series'>;
  prev: BlogPost | null;
  next: BlogPost | null;
}

const { lang, series, prev, next } = Astro.props;
const t = useTranslations(lang);
---

<nav class="series-nav" aria-label={series.data.title[lang]}>
  <p><a href={seriesUrl(lang, series.id)}>{series.data.title[lang]}</a></p>
  <div class="series-nav-links">
    {
      prev && (
        <a href={postUrl(prev)} rel="prev">
          <span class="label">← {t('post.prev')}</span>
          <span class="title">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a href={postUrl(next)} rel="next">
          <span class="label">{t('post.next')} →</span>
          <span class="title">{next.data.title}</span>
        </a>
      )
    }
  </div>
</nav>
